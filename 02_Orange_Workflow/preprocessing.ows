ri\', \'sendirian\', \'sendirinya\', \'seolah\', \'seorang\', \'sepanjang\', \'sepantasnya\', \'sepantasnyalah\', \'seperlunya\', \'seperti\', \'sepertinya\', \'sepihak\', \'sering\', \'seringnya\', \'serta\', \'serupa\', \'sesaat\', \'sesama\', \'sesampai\', \'sesegera\', \'sesekali\', \'seseorang\', \'sesuatu\', \'sesuatunya\', \'sesudah\', \'sesudahnya\', \'setelah\', \'setempat\', \'setengah\', \'seterusnya\', \'setiap\', \'setiba\', \'setibanya\', \'setidaknya\', \'setinggi\', \'seusai\', \'sewaktu\', \'si\', \'siapa\', \'siapakah\', \'siapapun\', \'sih\', \'sini\', \'sinilah\', \'soal\', \'soalnya\', \'suatu\', \'sudah\', \'sudahkah\', \'sudahlah\', \'supaya\', \'tadi\', \'tadinya\', \'tahu\', \'tahun\', \'tambah\', \'tambahnya\', \'tampak\', \'tampaknya\', \'tandas\', \'tandasnya\', \'tanya\', \'tanyakan\', \'tanyanya\', \'tegasnya\', \'telah\', \'tempat\', \'tengah\', \'tentang\', \'tentu\', \'tentulah\', \'tentunya\', \'tepat\', \'terakhir\', \'terasa\', \'terbanyak\', \'terdahulu\', \'terdapat\', \'terdiri\', \'terhadap\', \'terhadapnya\', \'teringat\', \'terjadi\', \'terjadilah\', \'terjadinya\', \'terkira\', \'terlebih\', \'terlihat\', \'termasuk\', \'ternyata\', \'tersampaikan\', \'tersebut\', \'tersebutlah\', \'tertentu\', \'tertuju\', \'terus\', \'terutama\', \'the\', \'tiap\', \'tiba\', \'tiga\', \'tinggi\', \'to\', \'toh\', \'tong\', \'tuh\', \'tunjuk\', \'turut\', \'tutur\', \'tuturnya\', \'u\', \'ucap\', \'ucapnya\', \'ujar\', \'ujarnya\', \'umum\', \'umumnya\', \'ungkap\', \'ungkapnya\', \'untuk\', \'usah\', \'usai\', \'via\', \'waduh\', \'wah\', \'wahai\', \'waktu\', \'waktunya\', \'walau\', \'walaupun\', \'wekekekek\', \'wk\', \'wk2k\', \'wkekeke\', \'wkwk\', \'wkwkkw\', \'wkwkwjwjk\', \'wkwkwk\', \'wkwkwkwk\', \'wkwowko\', \'wong\', \'woy\', \'x\', \'ya\', \'yah\', \'yahahahaha\', \'yaitu\', \'yakni\', \'yang\', \'ygy\', \'you\', \'z\'])\n\ndef load_resources():\n    candidates = [\n        os.path.join(os.getcwd(), "01_Dataset", "processed"),\n        os.path.abspath(os.path.join(os.getcwd(), "..", "01_Dataset", "processed")),\n        r"C:\\Users\\asus\\.gemini\\antigravity\\scratch\\tb_bigdata_final\\tb_bigdata-main\\01_Dataset\\processed",\n    ]\n    kamus = dict(EMBEDDED_KAMUS)\n    stopwords = set(EMBEDDED_STOPWORDS)\n    for folder in candidates:\n        k_path = os.path.join(folder, "kamus_normalisasi.csv")\n        s_path = os.path.join(folder, "stopwords_id.txt")\n        if os.path.isfile(k_path):\n            df_k = pd.read_csv(k_path, dtype=str, keep_default_na=False)\n            kamus = dict(zip(df_k["kata_asli"].str.strip().str.lower(),\n                             df_k["kata_baku"].str.strip().str.lower()))\n        if os.path.isfile(s_path):\n            with open(s_path, "r", encoding="utf-8") as fh:\n                stopwords = {line.strip().lower() for line in fh if line.strip()}\n        if os.path.isfile(k_path) or os.path.isfile(s_path):\n            break\n    return kamus, stopwords\n\nkamus, stopwords_set = load_resources()\n\n# Aturan deteksi cuitan non-opini (judul berita / link share X, promo bot, off-topic, gibberish)\nNETIZEN_OPINION_KEEP_IDS = {"X-0449", "X-0471", "X-0519", "X-0564", "X-0623"}\nPURE_HEADLINE_IDS = {"X-0007", "X-0008", "X-0013", "X-0109", "X-0134", "X-0238", "X-0473", "X-0484"}\nOFFTOPIC_SPAM_GIBBERISH_IDS = {"X-0511", "X-0728", "TT-0323", "TT-0512"}\n\nNEWS_MEDIA_PAT = re.compile(\n    r"(🔴\\s*live|lewat\\s+@user|melalui\\s+@user|"\n    r"^(?:baca\\s*(?:di\\s+sini)?\\s*:)|"\n    r"baca\\s+(?:berita\\s+)?selengkapnya|artikel\\s+selengkapnya|klik\\s+link\\s+berikut|"\n    r"selengkapnya\\s*(?:&gt;&gt;&gt;|bisa\\s+cek|klik\\s+video)|cari\\s+tahu\\s+di\\s+\\S+\\.(?:id|com)|"\n    r"cek\\s+rayatimes\\.id|cerita\\s+lengkapnya\\s+bisa\\s+dibaca|#shw6dekade|#rayatimes|"\n    r"simak\\s+(?:video|pembahasan)\\s+(?:lengkapnya|selengkapnya)|"\n    r"ikuti\\s+kuisnya\\s+di\\s+sini|instagram\\s+reel|subscribe\\s+akun|"\n    r"\\b(?:kontan\\.co\\.id|suaramerdeka\\.com|loketberita\\.id|jambi\\.tribunnews\\.com|tribunjambi\\.com|"\n    r"belumadajudul\\.com|sumselpost\\.co\\.id|radaraktual\\.com|kabarterdepan\\.com|afu\\.id|"\n    r"kbanews\\.com|rajamedia\\.co|podteks\\.id|kaltim\\.tribunnews\\.com|tribun-video\\.com|"\n    r"bitvonline\\.com|newscast\\.id|rmbanten\\.com|sinfonews\\.com|keuangannews\\.id|"\n    r"suara\\.com/news|suaragunungkidul\\.net|kebaruan\\.com|sinpo\\.id)\\b|"\n    r"gelora\\s+news|media\\s+indonesia\\s+media\\s+indonesia|monitorindonesia|duta\\s+crypto\\s+id)",\n    re.I\n)\n\nTIKTOK_STICKER_PAT = re.compile(\n    r"\\[(?:Tawa oke|Tertawa sampai menangis|Api|Berdoa|Tears of joy|Terkekeh|Suka|Menangis)\\]",\n    re.I\n)\nX_UI_PAT = re.compile(r"(?:^\\s*\\d+\\s+others\\s+|\\bFan\\s+account\\b|\\bMade\\s+with\\s+AI\\b)", re.I)\nURL_DOMAIN_PAT = re.compile(\n    r"(?:https?://\\S+|www\\.\\S+|\\b(?:[a-z0-9-]+\\.)+(?:co\\.id|or\\.id|com|id|net|co)(?:/\\S*)?)",\n    re.I\n)\n\ndef is_duplicated_headline_card(t):\n    words = re.sub(r"\\s+", " ", t.strip()).split()\n    if len(words) &lt; 10:\n        return False\n    return " ".join(words[:6]).lower() in " ".join(words[6:]).lower()\n\ndef preprocess_text(text):\n    t = html.unescape(str(text))\n    t = re.sub(r"[\\u200b-\\u200d\\ufeff]", "", t)\n    t = unicodedata.normalize("NFKC", t)\n    t = X_UI_PAT.sub(" ", t)\n    t = TIKTOK_STICKER_PAT.sub(" ", t)\n    t = t.lower()\n    t = URL_DOMAIN_PAT.sub(" ", t)\n    t = re.sub(r"@\\w+", " ", t)\n    t = re.sub(r"#\\w+", " ", t)\n    t = re.sub(r"([a-z]+)²([a-z]+)", r"\\1 \\2", t)\n    t = re.sub(r"([a-z]+)[²2]\\b", r"\\1", t)\n    t = re.sub(r"[^a-z\\s]", " ", t)\n    t = re.sub(r"\\s+", " ", t).strip()\n    tokens = []\n    for w in t.split():\n        if w in kamus:\n            mapped = kamus[w]\n        else:\n            w2 = re.sub(r"([a-z])\\1{2,}", r"\\1\\1", w)\n            w1 = re.sub(r"([a-z])\\1{2,}", r"\\1", w)\n            if w2 in kamus:\n                mapped = kamus[w2]\n            elif w1 in kamus:\n                mapped = kamus[w1]\n            else:\n                mapped = w1\n        for subw in mapped.split():\n            if len(subw) &gt;= 2 and subw not in stopwords_set:\n                tokens.append(subw)\n    return " ".join(tokens)\n\nif in_data is not None:\n    status_values = ("valid", "duplikat", "berita_link_x", "spam_gibberish", "kosong_pasca_cleaning")\n    status_to_idx = {v: idx for idx, v in enumerate(status_values)}\n    seen_texts = set()\n    status_list = []\n    teks_bersih_list = []\n    jumlah_kata_list = []\n\n    id_var = in_data.domain["id"]\n    plat_var = in_data.domain["platform"]\n    teks_var = in_data.domain["teks"]\n\n    for i in range(len(in_data)):\n        row_id = str(in_data[i, id_var])\n        row_plat = str(in_data[i, plat_var]).strip().lower()\n        row_teks = str(in_data[i, teks_var])\n        norm_key = re.sub(r"\\s+", " ", row_teks.strip().lower())\n\n        cleaned = preprocess_text(row_teks)\n        wc = len(cleaned.split()) if cleaned else 0\n\n        if norm_key in seen_texts:\n            st = "duplikat"\n        else:\n            seen_texts.add(norm_key)\n            if row_id in NETIZEN_OPINION_KEEP_IDS:\n                st = "valid" if wc &gt;= 1 else "kosong_pasca_cleaning"\n            elif row_id in OFFTOPIC_SPAM_GIBBERISH_IDS:\n                st = "spam_gibberish"\n            elif row_plat == "x" and (\n                NEWS_MEDIA_PAT.search(row_teks)\n                or is_duplicated_headline_card(row_teks)\n                or row_id in PURE_HEADLINE_IDS\n            ):\n                st = "berita_link_x"\n            elif wc == 0:\n                st = "kosong_pasca_cleaning"\n            else:\n                st = "valid"\n\n        status_list.append(float(status_to_idx[st]))\n        teks_bersih_list.append(cleaned)\n        jumlah_kata_list.append(float(wc))\n\n    status_var = DiscreteVariable("status_data", values=status_values)\n    jk_var = ContinuousVariable("jumlah_kata", number_of_decimals=0)\n    tb_var = StringVariable("teks_bersih")\n\n    new_attrs = list(in_data.domain.attributes) + [jk_var, status_var]\n    new_metas = list(in_data.domain.metas) + [tb_var]\n    new_domain = Domain(new_attrs, in_data.domain.class_vars, new_metas)\n\n    X_new = np.column_stack([\n        in_data.X,\n        np.array(jumlah_kata_list, dtype=float),\n        np.array(status_list, dtype=float),\n    ])\n    M_new = np.column_stack([in_data.metas, np.array(teks_bersih_list, dtype=object)])\n    out_data = Table.from_numpy(new_domain, X_new, in_data.Y, M_new)\n', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\xad\x00\x00\x00i\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
