'sudahkah\', \'sudahlah\', \'supaya\', \'tadi\', \'tadinya\', \'tahu\', \'tahun\', \'tambah\', \'tambahnya\', \'tampak\', \'tampaknya\', \'tandas\', \'tandasnya\', \'tanya\', \'tanyakan\', \'tanyanya\', \'tegasnya\', \'telah\', \'tempat\', \'tengah\', \'tentang\', \'tentu\', \'tentulah\', \'tentunya\', \'tepat\', \'terakhir\', \'terasa\', \'terbanyak\', \'terdahulu\', \'terdapat\', \'terdiri\', \'terhadap\', \'terhadapnya\', \'teringat\', \'terjadi\', \'terjadilah\', \'terjadinya\', \'terkira\', \'terlebih\', \'terlihat\', \'termasuk\', \'ternyata\', \'tersampaikan\', \'tersebut\', \'tersebutlah\', \'tertentu\', \'tertuju\', \'terus\', \'terutama\', \'the\', \'tiap\', \'tiba\', \'tiga\', \'tinggi\', \'to\', \'toh\', \'tuh\', \'tunjuk\', \'turut\', \'tutur\', \'tuturnya\', \'u\', \'ucap\', \'ucapnya\', \'ujar\', \'ujarnya\', \'umum\', \'umumnya\', \'ungkap\', \'ungkapnya\', \'untuk\', \'usah\', \'usai\', \'waduh\', \'wah\', \'wahai\', \'waktu\', \'waktunya\', \'walau\', \'walaupun\', \'wk\', \'wkwk\', \'wkwkwk\', \'wkwkwkwk\', \'wong\', \'woy\', \'x\', \'ya\', \'yah\', \'yaitu\', \'yakni\', \'yang\', \'you\', \'z\'])\n\ndef load_resources():\n    candidates = [\n        os.path.join(os.getcwd(), "01_Dataset", "processed"),\n        os.path.abspath(os.path.join(os.getcwd(), "..", "01_Dataset", "processed")),\n        r"C:\\Users\\asus\\.gemini\\antigravity\\scratch\\tb_bigdata\\tb_bigdata-main\\01_Dataset\\processed",\n    ]\n    kamus = dict(EMBEDDED_KAMUS)\n    stopwords = set(EMBEDDED_STOPWORDS)\n    for folder in candidates:\n        k_path = os.path.join(folder, "kamus_normalisasi.csv")\n        s_path = os.path.join(folder, "stopwords_id.txt")\n        if os.path.isfile(k_path):\n            df_k = pd.read_csv(k_path, dtype=str, keep_default_na=False)\n            kamus = dict(zip(df_k["kata_asli"].str.strip().str.lower(),\n                             df_k["kata_baku"].str.strip().str.lower()))\n        if os.path.isfile(s_path):\n            with open(s_path, "r", encoding="utf-8") as fh:\n                stopwords = {line.strip().lower() for line in fh if line.strip()}\n        if os.path.isfile(k_path) or os.path.isfile(s_path):\n            break\n    return kamus, stopwords\n\nkamus, stopwords_set = load_resources()\n\n# 2. Fungsi pembersihan &amp; normalisasi teks\ndef preprocess_text(text):\n    # a. Decode HTML entities (&amp;amp;, &amp;quot;, dll.) &amp; hapus karakter tak terlihat\n    t = html.unescape(str(text))\n    t = re.sub(r"[\\u200b-\\u200d\\ufeff]", "", t)\n    # b. Normalisasi Unicode NFKC (mengubah font stylized bold/monospace ke huruf Latin)\n    t = unicodedata.normalize("NFKC", t)\n    # c. Case folding (huruf kecil semua)\n    t = t.lower()\n    # d. Hapus URL, mention (@user), dan hashtag (#tag)\n    t = re.sub(r"(https?://\\S+|www\\.\\S+|t\\.co/\\S+)", " ", t)\n    t = re.sub(r"@\\w+", " ", t)\n    t = re.sub(r"#\\w+", " ", t)\n    # e. Tangani penanda reduplikasi (orang² / anak2 -&gt; orang / anak)\n    t = re.sub(r"([a-z]+)²([a-z]+)", r"\\1 \\2", t)\n    t = re.sub(r"([a-z]+)[²2]\\b", r"\\1", t)\n    # f. Hapus angka, emoji, tanda baca, dan simbol non-alfabet\n    t = re.sub(r"[^a-z\\s]", " ", t)\n    t = re.sub(r"\\s+", " ", t).strip()\n    # g. Normalisasi pemanjangan huruf, kamus kata gaul-&gt;baku, dan hapus stopwords\n    #    (kata negasi seperti tidak, bukan, jangan, belum, tanpa dipertahankan!)\n    tokens = []\n    for w in t.split():\n        if w in kamus:\n            mapped = kamus[w]\n        else:\n            w2 = re.sub(r"([a-z])\\1{2,}", r"\\1\\1", w)\n            w1 = re.sub(r"([a-z])\\1{2,}", r"\\1", w)\n            if w2 in kamus:\n                mapped = kamus[w2]\n            elif w1 in kamus:\n                mapped = kamus[w1]\n            else:\n                mapped = w1\n        for subw in mapped.split():\n            if len(subw) &gt;= 2 and subw not in stopwords_set:\n                tokens.append(subw)\n    return " ".join(tokens)\n\n# 3. Terapkan deduplikasi case-insensitive, buang fragmen berita/off-topic, dan bersihkan teks\nif in_data is not None:\n    offtopic_ids = {"X-1152", "X-1157", "X-1445"}\n    seen_texts = set()\n    keep_indices = []\n    teks_bersih_list = []\n    jumlah_kata_list = []\n\n    id_var = in_data.domain["id"]\n    teks_var = in_data.domain["teks"]\n\n    for i in range(len(in_data)):\n        row_id = str(in_data[i, id_var])\n        row_teks = str(in_data[i, teks_var])\n        norm_key = re.sub(r"\\s+", " ", row_teks.strip().lower())\n        if row_id in offtopic_ids:\n            continue\n        if norm_key in seen_texts:\n            continue\n        seen_texts.add(norm_key)\n\n        cleaned = preprocess_text(row_teks)\n        wc = len(cleaned.split()) if cleaned else 0\n        keep_indices.append(i)\n        teks_bersih_list.append(cleaned)\n        jumlah_kata_list.append(float(wc))\n\n    sub = in_data[keep_indices]\n    new_attrs = list(sub.domain.attributes) + [ContinuousVariable("jumlah_kata")]\n    new_metas = list(sub.domain.metas) + [StringVariable("teks_bersih")]\n    new_domain = Domain(new_attrs, sub.domain.class_vars, new_metas)\n\n    X_new = np.column_stack([sub.X, np.array(jumlah_kata_list, dtype=float)])\n    M_new = np.column_stack([sub.metas, np.array(teks_bersih_list, dtype=object)])\n    out_data = Table.from_numpy(new_domain, X_new, sub.Y, M_new)\n', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\xad\x00\x00\x00i\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
