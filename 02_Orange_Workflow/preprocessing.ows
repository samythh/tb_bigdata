		<properties node_id="5" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': None, 'scriptLibrary': [{'name': 'Pembersihan &amp; Normalisasi Teks', 'script': "# Preprocessing Teks Bahasa Indonesia - Respons Publik Pengunduran Diri Wapres\nimport re\nimport numpy as np\nfrom Orange.data import Table, Domain, StringVariable, ContinuousVariable\n\nif in_data is not None:\n    # 1. Kamus Normalisasi Kata Gaul / Slang\n    kamus_slang = {\n        'gk': 'tidak', 'gak': 'tidak', 'ga': 'tidak', 'ngga': 'tidak', 'nggak': 'tidak',\n        'tdk': 'tidak', 'bkn': 'bukan', 'engga': 'tidak', 'enggak': 'tidak',\n        'bgt': 'banget', 'bgtt': 'banget', 'bgtu': 'begitu', 'klo': 'kalau', 'kl': 'kalau',\n        'kalo': 'kalau', 'tp': 'tapi', 'tpi': 'tapi', 'dgn': 'dengan', 'dg': 'dengan',\n        'dr': 'dari', 'dri': 'dari', 'sy': 'saya', 'aq': 'saya', 'gw': 'saya', 'gue': 'saya',\n        'lu': 'kamu', 'lo': 'kamu', 'km': 'kamu', 'udh': 'sudah', 'udah': 'sudah',\n        'sdh': 'sudah', 'blm': 'belum', 'blom': 'belum', 'yg': 'yang', 'yng': 'yang',\n        'utk': 'untuk', 'untk': 'untuk', 'krn': 'karena', 'karna': 'karena', 'pdhl': 'padahal',\n        'sm': 'sama', 'smp': 'sampai', 'ampe': 'sampai', 'emng': 'memang', 'emang': 'memang',\n        'bs': 'bisa', 'gmn': 'bagaimana', 'knp': 'kenapa', 'kyk': 'seperti', 'kayak': 'seperti',\n        'bener': 'benar', 'dpt': 'dapat', 'jd': 'jadi', 'jg': 'juga', 'org': 'orang',\n        'bnyk': 'banyak', 'skrg': 'sekarang', 'tau': 'tahu', 'wapres': 'wakil presiden'\n    }\n\n    # 2. Stopwords Bahasa Indonesia\n    stopwords = set([\n        'yang', 'di', 'dan', 'dari', 'ke', 'ini', 'itu', 'pada', 'untuk',\n        'dengan', 'adalah', 'sebagai', 'oleh', 'dalam', 'tersebut', 'secara',\n        'akan', 'ia', 'mereka', 'kita', 'kami', 'serta', 'ada', 'karena'\n    ])\n\n    def clean_text(text):\n        if not text:\n            return ''\n        t = str(text).lower()\n        t = re.sub(r'https?://\\S+|www\\.\\S+', '', t)\n        t = re.sub(r'@\\w+|#\\w+', '', t)\n        t = re.sub(r'[^a-z0-9\\s]', ' ', t)\n        words = t.split()\n        cleaned = [kamus_slang.get(w, w) for w in words if kamus_slang.get(w, w) not in stopwords and len(w) &gt; 1]\n        return ' '.join(cleaned)\n\n    # Identifikasi kolom teks\n    meta_names = [v.name for v in in_data.domain.metas]\n    attr_names = [v.name for v in in_data.domain.attributes]\n    text_col = 'teks' if 'teks' in meta_names else ('teks_asli' if 'teks_asli' in meta_names else meta_names[0])\n    text_idx = meta_names.index(text_col)\n\n    raw_texts = [str(row.metas[text_idx]) for row in in_data]\n    cleaned_texts = [clean_text(t) for t in raw_texts]\n    word_counts = [len(t.split()) for t in cleaned_texts]\n\n    # Domain baru\n    new_attrs = list(in_data.domain.attributes)\n    var_wc = ContinuousVariable('jumlah_kata')\n    if 'jumlah_kata' not in attr_names:\n        new_attrs.append(var_wc)\n\n    new_metas = list(in_data.domain.metas)\n    var_clean = StringVariable('teks_bersih')\n    if 'teks_bersih' not in meta_names:\n        new_metas.append(var_clean)\n\n    new_domain = Domain(new_attrs, in_data.domain.class_vars, new_metas)\n    out_table = Table.from_table(new_domain, in_data)\n\n    if 'jumlah_kata' not in attr_names:\n        out_table[:, var_wc] = np.array(word_counts).reshape(-1, 1)\n\n    clean_idx = new_metas.index(var_clean)\n    for i, ct in enumerate(cleaned_texts):\n        out_table.metas[i, clean_idx] = ct\n\n    out_data = out_table\nelse:\n    out_data = None\n"}], 'scriptText': '# =====================================================================\n# PREPROCESSING TEKS BAHASA INDONESIA - TB BIG DATA (PERAN 5)\n# Topik: Respons Publik terhadap Pengunduran Diri Wapres di Media Sosial\n# Input : in_data (hasil Select Rows tanggal &gt;= 2026-01-01 -&gt; 2.531 baris)\n# Output: out_data (dengan kolom tambahan teks_bersih &amp; jumlah_kata)\n# =====================================================================\nimport os, re, html, unicodedata\nimport numpy as np\nimport pandas as pd\nfrom Orange.data import Table, Domain, StringVariable, ContinuousVariable\n\n# 1. Muat kamus normalisasi &amp; daftar stopwords\n#    Mencari file eksternal di 01_Dataset/processed/; jika dipindah, pakai salinan bawaan\nEMBEDDED_KAMUS = {\'aamiin\': \'amin\', \'aduhhh\': \'aduh\', \'aj\': \'saja\', \'aja\': \'saja\', \'ak\': \'saya\', \'akn\': \'akan\', \'aku\': \'saya\', \'alamiiiin\': \'amin\', \'alhamdu\': \'alhamdulillah\', \'alhamdulilaahhh\': \'alhamdulillah\', \'alhamdulilah\': \'alhamdulillah\', \'alhamdulillaaaaahhh\': \'alhamdulillah\', \'alhamdulillahhhhhh\': \'alhamdulillah\', \'alhamdulilllah\': \'alhamdulillah\', \'alhmdulillah\': \'alhamdulillah\', \'alloh\': \'allah\', \'ama\': \'sama\', \'amiiin\': \'amin\', \'amiin\': \'amin\', \'amiinnn\': \'amin\', \'aminnn\': \'amin\', \'ap\': \'apa\', \'apaan\': \'apa\', \'aq\': \'saya\', \'ayooooo\': \'ayo\', \'bakal\': \'akan\', \'bakalan\': \'akan\', \'balikin\': \'kembalikan\', \'bangett\': \'banget\', \'bangettt\': \'banget\', \'bapa\': \'bapak\', \'belain\': \'membela\', \'belom\': \'belum\', \'bener\': \'benar\', \'beneran\': \'benaran\', \'best\': \'terbaik\', \'bg\': \'bang\', \'bgt\': \'banget\', \'bgtt\': \'banget\', \'biar\': \'agar\', \'biarin\': \'biarkan\', \'bikin\': \'membuat\', \'bilang\': \'mengatakan\', \'bkin\': \'membuat\', \'bkn\': \'bukan\', \'blg\': \'mengatakan\', \'blm\': \'belum\', \'bln\': \'bulan\', \'blom\': \'belum\', \'bngt\': \'banget\', \'bnr\': \'benar\', \'bnyak\': \'banyak\', \'bnyk\': \'banyak\', \'bp\': \'bapak\', \'bpk\': \'bapak\', \'bro\': \'saudara\', \'bs\': \'bisa\', \'bsa\': \'bisa\', \'bu\': \'ibu\', \'byk\': \'banyak\', \'cawapres\': \'wakil presiden\', \'cedih\': \'sedih\', \'cm\': \'hanya\', \'cmn\': \'hanya\', \'cuma\': \'hanya\', \'cuman\': \'hanya\', \'dah\': \'sudah\', \'dak\': \'tidak\', \'dapet\': \'dapat\', \'dg\': \'dengan\', \'dgn\': \'de