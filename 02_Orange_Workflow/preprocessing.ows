		<properties node_id="4" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': None, 'scriptLibrary': [{'name': 'Table from numpy', 'script': 'import numpy as np\nfrom Orange.data import Table, Domain, ContinuousVariable, DiscreteVariable\n\ndomain = Domain([ContinuousVariable("age"),\n                 ContinuousVariable("height"),\n                 DiscreteVariable("gender", values=("M", "F"))])\narr = np.array([\n  [25, 186, 0],\n  [30, 164, 1]])\nout_data = Table.from_numpy(domain, arr)\n', 'filename': None}], 'scriptText': '# =====================================================================\n# PREPROCESSING TEKS BAHASA INDONESIA - TB BIG DATA (PERAN 5)\n# Dataset Final per 25 Nov 2026 (2.776 baris: X, YouTube, TikTok)\n# Output: out_data (semua baris ditandai status_data + teks_bersih + jumlah_kata)\n#         agar Select Rows memisahkan 2.660 data valid vs 116 data terbuang!\n# =====================================================================\nimport os, re, html, unicodedata\nimport numpy as np\nimport pandas as pd\nfrom Orange.data import Table, Domain, StringVariable, ContinuousVariable, DiscreteVariable\n\nEMBEDDED_KAMUS = {\'aamiin\': \'amin\', \'abis\': \'habis\', \'aduhhh\': \'aduh\', \'aj\': \'saja\', \'aja\': \'saja\', \'aje\': \'saja\', \'ak\': \'saya\', \'akn\': \'akan\', \'aku\': \'saya\', \'alamiiiin\': \'amin\', \'alhamdu\': \'alhamdulillah\', \'alhamdulilaahhh\': \'alhamdulillah\', \'alhamdulilah\': \'alhamdulillah\', \'alhamdulillaaaaahhh\': \'alhamdulillah\', \'alhamdulillahhhhhh\': \'alhamdulillah\', \'alhamdulilllah\': \'alhamdulillah\', \'alhamdullilah\': \'alhamdulillah\', \'alhamdullillah\': \'alhamdulillah\', \'alhmdulillah\': \'alhamdulillah\', \'allhmdulilah\': \'alhamdulillah\', \'alloh\': \'allah\', \'ama\': \'sama\', \'amien\': \'amin\', \'amiiin\': \'amin\', \'amiin\': \'amin\', \'amiinnn\': \'amin\', \'aminn\': \'amin\', \'aminnn\': \'amin\', \'ampe\': \'sampai\', \'ap\': \'apa\', \'