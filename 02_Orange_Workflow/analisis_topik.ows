		<properties node_id="6" format="literal">{'scriptText': '# Menentukan topik dominan tiap komentar (probabilitas topik tertinggi)\nimport numpy as np\nfrom Orange.data import DiscreteVariable\ndata = in_data\ncols = [v for v in data.domain.attributes if v.name.startswith("Topic")]\nX = np.column_stack([data.get_column(v) for v in cols])\nvar = DiscreteVariable("topik_dominan", values=[v.name for v in cols])\nout_data = data.add_column(var, np.argmax(X, axis=1).astype(float))\n', 'currentScriptIndex': 0, '__version__': 2, 'scriptLibrary': [{'name': 'topik_dominan', 'script': '# Menentukan topik dominan tiap komentar (probabilitas topik tertinggi)\nimport numpy as np\nfrom Orange.data import DiscreteVariable\ndata = in_data\ncols = [v for v in data.domain.attributes if v.name.startswith("Topic")]\nX = np.column_stack([data.get_column(v) for v in cols])\nvar = DiscreteVariable("topik_dominan", values=[v.name for v in cols])\nout_data = data.add_column(var, np.argmax(X, axis=1).astype(float))\n', 'filename': None}]}</properties>
